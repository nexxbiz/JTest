{
  "version": "1.0",
  "components": {
    "templates": [
      {
        "name": "project-instances",
        "description": "Projects a list into a new list shape: each item renamed and its status translated.",
        "params": {
          "items": { "type": "array", "required": true },
          "map": { "type": "object", "default": { "Completed": "Finished", "Suspended": "Running" } }
        },
        "steps": [
          { "type": "wait", "ms": 1, "save": { "$.out": [] } },
          {
            "type": "for",
            "items": "{{ $.items }}",
            "steps": [
              {
                "type": "wait",
                "ms": 1,
                "save": { "$.out[]": { "id": "{{ $.item.id }}", "status": "{{ $.map['{{ $.item.s }}'] }}" } }
              }
            ]
          }
        ],
        "output": { "out": "{{ $.out }}" }
      },
      {
        "name": "state-by-name",
        "description": "Builds a name-keyed object from a list of {name, value} entries.",
        "params": { "entries": { "type": "array", "required": true } },
        "steps": [
          {
            "type": "for",
            "items": "{{ $.entries }}",
            "steps": [ { "type": "wait", "ms": 1, "save": { "$.state.{{ $.item.name }}": "{{ $.item.value }}" } } ]
          }
        ],
        "output": { "state": "{{ $.state }}" }
      }
    ]
  }
}
