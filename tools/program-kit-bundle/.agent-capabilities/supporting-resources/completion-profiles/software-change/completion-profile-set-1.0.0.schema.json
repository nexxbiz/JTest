{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/capabilities/completion-profile-set/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:capability-completion-profile-set",
  "x-program-kit-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "consumers",
    "identity",
    "independentlyInvokable",
    "manifestVersion",
    "profiles",
    "version"
  ],
  "properties": {
    "authority": {
      "const": "none"
    },
    "consumers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "profileIds"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "profileIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^pkid:completion-profile:program-kit:[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "identity": {
      "const": "pkid:completion-profile-set:program-kit:software-change"
    },
    "independentlyInvokable": {
      "const": false
    },
    "manifestVersion": {
      "const": "1.0.0"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "order",
          "path",
          "purpose",
          "requiresSeparateAuthority",
          "sha256",
          "version"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "pattern": "^pkid:completion-profile:program-kit:[a-z0-9-]+$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "path": {
            "type": "string",
            "pattern": "^profiles/[a-z0-9-]+\\.md$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "requiresSeparateAuthority": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "version": {
            "const": "1.0.0"
          }
        }
      }
    },
    "version": {
      "const": "1.0.0"
    }
  }
}
