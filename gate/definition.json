        "revision": "1.0.0",
        "kind": "program-kit-public-contract",
        "semanticOwnerId": "pkid:domain:program-kit:generated-source-contract",
        "sourceContract": {
          "identity": "pkid:contract:program-kit:generated-source-convention",
