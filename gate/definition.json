          "digest": "sha256:32beba7214f2b52af50eb03c8339203db83946ebd1d8ef73214368410c1f989c"
        },
        "diagnosticId": "PKCC001",
        "title": "Program Kit generated-source convention",
        "category": "GeneratedSource",
        "defaultSeverity": "error",
        "rationale": "Generated Program Kit output must keep its exact ownership header and canonical ProgramKitGenerated path so tampering and misplacement are compilation-observable.",
        "remediation": "Regenerate the tree with tools/generate-cli-host.ps1 instead of editing generated files; keep consumer sources outside ProgramKitGenerated/.",
        "compilationObservableClaim": "For an opted-in compilation, a syntax tree that uses the exact Program Kit generated-source ownership header is under the exact ProgramKitGenerated/<intent>/<file>.cs logical path, and a tree under that path has the exact ownership header.",
        "layer": "compiler",
        "claimsOutsideRule": [
          "Generator identity, ownership transfer, manifest selection, exact source inventory, and physical-source forgery resistance are gate-mechanics claims and are not established by PKCC001.",
          "Program Kit repository layout, namespace, warning-ledger, behavior, and private generated-source policy remain PKCS-owned and are not established by PKCC001."
        ],
        "projectProfileIds": ["pkid:profile:jtest:cli-host-project"],
        "sourceProfileIds": [
          "pkid:profile:jtest:cli-host-generated",
          "pkid:profile:jtest:cli-host-physical"
