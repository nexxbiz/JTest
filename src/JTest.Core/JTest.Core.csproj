<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Information -->
		<PackageId>JTest.Core</PackageId>
		<Title>JTest Core Framework</Title>
		<Authors>NexxBiz</Authors>
		<Description>Core framework library for JTest - A universal JSON-based API testing framework. Provides the core functionality for defining, executing, and validating API tests using JSON configuration files.</Description>
		<PackageProjectUrl>https://github.com/nexxbiz/JTest</PackageProjectUrl>
		<RepositoryUrl>https://github.com/nexxbiz/JTest</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>api-testing;json;testing;framework;automation;http-client</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JsonPath.Net" Version="1.0.0" />
		<PackageReference Include="JsonSchema.Net" Version="9.4.0" />
		<PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
		<PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- JTest 2.0: ship the language schema and self-contained HTML report assets as
	     embedded resources so the tool always carries a version-matched copy. -->
	<ItemGroup>
		<EmbeddedResource Include="Language\Schema\**\*.json" />
		<EmbeddedResource Include="Reporting\Html\*.css" />
		<EmbeddedResource Include="Reporting\Html\*.js" />
		<EmbeddedResource Include="Reporting\Html\*.html" />
	</ItemGroup>

</Project>
