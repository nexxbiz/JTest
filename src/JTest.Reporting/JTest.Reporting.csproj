<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>JTest.Reporting</PackageId>
    <Description>JTest 2.0 evidence and reporting: the canonical result document, capture-time redaction support, deterministic catalog and standalone report writers, and the embedded static viewer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JTest.Engine\JTest.Engine.csproj" />
    <PackageReference Include="Orbyss.ProgramKit.Artifacts" />
    <PackageReference Include="Orbyss.ProgramKit.Serialization.JSON" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\jtest-result-2.0.0.schema.json" Link="Schemas\jtest-result-2.0.0.schema.json" LogicalName="JTest.Reporting.Schemas.jtest-result-2.0.0.schema.json" />
    <EmbeddedResource Include="Viewer\index.html" LogicalName="JTest.Reporting.Viewer.index.html" />
    <EmbeddedResource Include="Viewer\viewer.css" LogicalName="JTest.Reporting.Viewer.viewer.css" />
    <EmbeddedResource Include="Viewer\viewer.js" LogicalName="JTest.Reporting.Viewer.viewer.js" />
  </ItemGroup>

</Project>
