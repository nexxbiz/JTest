<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>JTest.Cli</PackageId>
    <Description>The jtest command-line tool: runs, validates, and describes JTest 2.0 suites and writes truthful reports.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jtest</ToolCommandName>
    <AssemblyName>jtest</AssemblyName>
    <RootNamespace>JTest.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JTest.Cli.Tests" />
    <InternalsVisibleTo Include="JTest.AcceptanceTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JTest.Language\JTest.Language.csproj" />
    <ProjectReference Include="..\JTest.Engine\JTest.Engine.csproj" />
    <ProjectReference Include="..\JTest.Reporting\JTest.Reporting.csproj" />
  </ItemGroup>

</Project>
