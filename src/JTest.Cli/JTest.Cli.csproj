<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>JTest.Cli</PackageId>
    <Description>The jtest command implementations: suite discovery and loading, run/validate/describe execution with evidence-based exit codes, report location printing, and best-effort report opening. Hosted by the generated console host in JTest.Cli.Host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JTest.Cli.Tests" />
    <InternalsVisibleTo Include="JTest.AcceptanceTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JTest.Language\JTest.Language.csproj" />
    <ProjectReference Include="..\JTest.Engine\JTest.Engine.csproj" />
    <ProjectReference Include="..\JTest.Reporting\JTest.Reporting.csproj" />
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

</Project>
